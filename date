let newDate = new Date();
console.log(newDate);
console.log(newDate.getFullYear());//2026
console.log(newDate.getMonth());//7 (August is the 8th month, so it's 7 in zero-based indexing)
console.log(newDate.getDate());//14
console.log(newDate.getHours());//6
console.log(newDate.getMinutes());//58
