let currentDate = new Date();
console.log(currentDate);//2026-08-14T13:10:31.734Z

console.log(Date.toString());//function Date() { [native code] }
console.log(currentDate.toDateString());//Fri Aug 14 2026 //gives date and day
console.log(currentDate.toLocaleString())//8/14/2026, 6:29:14 AM //gives date and time
console.log(typeof currentDate);//object


