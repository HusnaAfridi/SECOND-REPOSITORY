console.log(Math);//Object [Math] {}

console.log(Math.abs(-4));//4//change - sign into positive

console.log(Math.round(4.6));//round off to 5

console.log(Math.ceil(26.12))//27//round up a number

console.log(Math.floor(26.12));//26//round down a number

console.log(Math.min(1,2,3,4));//shows minimum number

console.log(Math.max(1,2,3,4));//shows maximum number

console.log(Math.random());//any random number//gives values always between 0 and 1

console.log(Math.random()*10); //gives values greater than 1

console.log(Math.random()*10+1);//greater than 1

