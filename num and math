const score=400
const balance=new Number(1000)
console.log(balance);//[Number: 1000] //shows the value of balance
console.log(score); // 400 //shows the value of score

console.log(balance.toString());//1000 //shows the value of balance in string format.

console.log(balance.toString().length);// 4 //shows the length of the string representation of balance

console.log(balance.toFixed(2));//1000.00

const otherNumber=23.9999
console.log(otherNumber.toPrecision(3));//change to a precise value of 3 digit i.e 24.0

const hundred=1000000
console.log(hundred.toLocaleString(1));//1,000,000

